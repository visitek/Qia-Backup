{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qia Backup",
  "version": "0.1.0",
  "mainBinaryName": "qia-backup",
  "identifier": "com.quantaia.backup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Qia Backup",
        "width": 1120,
        "height": 780,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Qia Backup: Time Machine snapshots to AWS S3 or Backblaze B2",
    "longDescription": "Qia Backup backs up APFS local snapshots to AWS S3 or Backblaze B2 using content-addressed blobs, packed trees and per-backup records.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
